# ── Database ───────────────────────────────────────────────────────────────
# Any Postgres connection string. Free options: Neon (neon.tech) or Supabase.
# Leave unset locally to use the embedded PGlite database in ./.data
DATABASE_URL=

# ── Email (SMTP) ───────────────────────────────────────────────────────────
# Leave SMTP_HOST unset locally: emails are saved to ./.data/outbox and links are logged.
# Gmail (free, 500/day): create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.newsletter.account@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=your.newsletter.account@gmail.com

# ── App ────────────────────────────────────────────────────────────────────
# Public URL used in email links. On Vercel this is detected automatically.
SITE_URL=http://localhost:3000
# Protects /api/cron/send. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=generate-a-long-random-string
