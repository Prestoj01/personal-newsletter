{
  "name": "personal-newsletter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fetch-news": "tsx scripts/fetch-news.ts",
    "predev": "node -e \"require('fs').existsSync('public/data/news.json')||process.exit(1)\" || npm run fetch-news",
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "tsx scripts/make-fixture-data.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fast-xml-parser": "^5.12.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
